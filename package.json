{
  "name": "read-the-code-axi",
  "version": "0.1.1",
  "description": "Local-first browser code review for exact Git revisions",
  "type": "module",
  "bin": {
    "read-the-code-axi": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "clean": "rm -rf dist coverage playwright-report test-results",
    "build:ui": "vite build",
    "build:cli": "tsup",
    "build": "npm run clean && npm run build:ui && npm run build:cli",
    "dev": "vite",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:skill": "npm run build && node scripts/validate-skill.mjs",
    "test:skill:built": "node scripts/validate-skill.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "fixture": "node scripts/create-fixture.mjs .test-state/example-repository",
    "fixture:large": "node scripts/create-large-fixture.mjs .test-state/large-repository",
    "measure:baseline": "node scripts/measure-baseline.mjs .test-state/large-repository",
    "screenshot": "node scripts/capture-screenshot.mjs",
    "check": "npm run format && npm run lint && npm run typecheck && npm test && npm run build && npm run test:skill:built && npm run test:pack",
    "release:check": "npm run check && npm run test:e2e && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "keywords": [
    "git",
    "code-review",
    "diff",
    "cli",
    "local-first"
  ],
  "author": "Kevin Kenyon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvkenyon/read-the-code.git"
  },
  "bugs": {
    "url": "https://github.com/kvkenyon/read-the-code/issues"
  },
  "homepage": "https://github.com/kvkenyon/read-the-code#readme",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@toon-format/toon": "4.1.1",
    "commander": "^14.0.1",
    "highlight.js": "^11.11.1",
    "parse-diff": "^0.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
